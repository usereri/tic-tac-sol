# Local surfpool (default). For devnet use https://api.devnet.solana.com and wss://api.devnet.solana.com
VITE_RPC_URL=http://127.0.0.1:8899
VITE_WS_URL=ws://127.0.0.1:8900
# localnet | devnet
VITE_CLUSTER=localnet
# Cross-device matchmaking over Supabase Realtime (Project Settings → API keys).
# Leave unset to match tabs of the same browser only.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
